// Priors and rules file
// *********************
[PARAMETERS]
//#isInt? #name #dist.#min #max
//all Ns are in number of haploid individuals
1 NCUR unif 200 20000 output
1 TENDBOT unif 500 1500 output
1 TANC unif 2000 30000 output
1 LBOT unif 1 100 hide
0 RESBOT logunif 1e-3 1 hide
0 RESANC logunif 1 1e2 hide

[COMPLEX PARAMETERS]
0 RESENDBOT = 1/RESBOT hide
1 TBOT = TENDBOT - LBOT output
1 NBOT = NCUR * RESBOT output
1 NANC = NCUR * RESANC output